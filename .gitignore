# Java and Gradle build output. Output dirs are anchored to the repo root and to each module
# (modules/<module>/) so a source package named `build`, `out` or `target`
# (e.g. src/main/java/pm/crypto/build/) is never ignored. Keep in step with .semgrepignore and
# the semgrepCert inputs in build.gradle.kts.
.gradle/
/build/
/modules/build/
/modules/*/build/
/out/
/modules/*/out/
/target/
/modules/*/target/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear

# Generated release artifacts (anchored: docs/release/ is documentation; packaging output goes to
# modules/pm-cli/build/release/, already ignored above)
/dist/
/release/
*.dmg
*.msi
*.exe
*.pkg
*.deb
*.rpm

# IDE and editor files
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# Operating-system files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.swp

# Local configuration and environment files
.env
.env.*
!.env.example

# Private keys, certificates, and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Local passwordManager data. *.pmv is the real vault extension (VaultPaths.VAULT_FILE);
# the store also writes <name>.lock, <name>.tmp and <name>.bak.1..3 beside it.
*.pmv
*.pmv.lock
*.pmv.bak.*
*.pmvault
*.vault
vaults/
backups/
recovery/

# jqwik example database (per-machine)
.jqwik-database

# Jazzer local fuzzing corpus (JAZZER_FUZZ=1 runs)
.cifuzz-corpus/
# Jazzer findings written next to the seeds (crash-<sha1>, timeout-*, oom-*, slow-unit-*, leak-*).
# A fixed finding is committed on purpose, renamed to a descriptive seed (see
# docs/security/fuzz/M3-fuzz-runs.md), so a raw reproducer is never committed by accident.
modules/pm-fuzz/src/test/resources/**/crash-*
modules/pm-fuzz/src/test/resources/**/timeout-*
modules/pm-fuzz/src/test/resources/**/oom-*
modules/pm-fuzz/src/test/resources/**/slow-unit-*
modules/pm-fuzz/src/test/resources/**/leak-*
