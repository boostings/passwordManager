<?xml version="1.0" encoding="UTF-8"?>
<!-- Exclusions must reference a docs/security/cert-exceptions.md entry. Keep each match as narrow as possible. -->
<FindBugsFilter>
    <!-- CE-001: AES/KWP (RFC 5649) carries its own integrity check; FindSecBugs only whitelists GCM. -->
    <Match>
        <Class name="pm.crypto.KeyWrap"/>
        <Method name="initCipher"/>
        <Bug pattern="CIPHER_INTEGRITY"/>
    </Match>
    <!-- CE-004: refuseEscape must compare the generic result to the buffer by reference. -->
    <Match>
        <Class name="pm.crypto.SecretBytes"/>
        <Method name="refuseEscape"/>
        <Bug pattern="EC_UNRELATED_TYPES_USING_POINTER_EQUALITY"/>
    </Match>
    <!-- CE-003: holder records intentionally hand the caller a live vault/session handle (ownership transfer). -->
    <Match>
        <Class name="pm.vault.CreatedVault"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="pm.tui.CreatedSession"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- CE-005: one explicit collection before refusing Argon2 for lack of heap, so garbage is not counted as in use. -->
    <Match>
        <Class name="pm.crypto.Kdf"/>
        <Method name="collectGarbage"/>
        <Bug pattern="DM_GC"/>
    </Match>
    <!-- CE-007: the env runner executes the argv the user approved; that is its purpose. -->
    <Match>
        <Class name="pm.approval.run.EnvRunner"/>
        <Method name="start"/>
        <Bug pattern="COMMAND_INJECTION"/>
    </Match>
    <!-- CE-011: a pinning trust manager for self-signed peers has no CA list to advertise; the check methods enforce the pin. -->
    <Match>
        <Class name="pm.crypto.Tls$PinningTrustManager"/>
        <Method name="getAcceptedIssuers"/>
        <Bug pattern="WEAK_TRUST_MANAGER"/>
    </Match>
    <!-- CE-012: an SSLContext's socket factories return SSL sockets by contract; the casts cannot fail. -->
    <Match>
        <Class name="pm.sharing.net.Lan"/>
        <Or>
            <Method name="listen"/>
            <Method name="accept"/>
            <Method name="connect"/>
        </Or>
        <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
    </Match>
</FindBugsFilter>
