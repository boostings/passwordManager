<?xml version="1.0" encoding="UTF-8"?>
<!-- Exclusions must reference a docs/security/cert-exceptions.md entry. Keep each match as narrow as possible. -->
<FindBugsFilter>
    <!-- CE-001: AES/KWP (RFC 5649) carries its own integrity check; FindSecBugs only whitelists GCM. -->
    <Match>
        <Class name="pm.crypto.KeyWrap"/>
        <Method name="initCipher"/>
        <Bug pattern="CIPHER_INTEGRITY"/>
    </Match>
    <!-- CE-003: holder records intentionally hand the caller a live vault/session handle (ownership transfer). -->
    <Match>
        <Class name="pm.vault.CreatedVault"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="pm.tui.CreatedSession"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- CE-005: one explicit collection before refusing Argon2 for lack of heap, so garbage is not counted as in use. -->
    <Match>
        <Class name="pm.crypto.Kdf"/>
        <Method name="collectGarbage"/>
        <Bug pattern="DM_GC"/>
    </Match>
</FindBugsFilter>
