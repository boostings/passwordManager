# Java and Gradle build output. Output dirs are anchored to the repo root and to each module
# (modules/<module>/) so a source package named `build`, `out` or `target`
# (e.g. src/main/java/pm/crypto/build/) is never ignored. Keep in step with .semgrepignore and
# the semgrepCert inputs in build.gradle.kts.
.gradle/
/build/
/modules/build/
/modules/*/build/
/out/
/modules/*/out/
/target/
/modules/*/target/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear

# Generated release artifacts
dist/
release/
*.dmg
*.msi
*.exe
*.pkg
*.deb
*.rpm

# IDE and editor files
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# Operating-system files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.swp

# Local configuration and environment files
.env
.env.*
!.env.example

# Private keys, certificates, and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Local passwordManager data
*.pmvault
*.vault
vaults/
backups/
recovery/

# jqwik example database (per-machine)
.jqwik-database
